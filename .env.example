# Required - Telegram Bot API token
BOT_TOKEN=

# Server port for health endpoint (default 3000)
PORT=3000

# development | production
NODE_ENV=production

# Optional - Telegram chat ID for admin notifications (e.g. "bot woke up")
ADMIN_TELEGRAM_ID=

# silent | error | warn | info (default info)
LOG_LEVEL=info

# Tax config (3rd group): ЄН and військовий збір in % of the income, ЄСВ fixed per month in UAH
TAX_EN_PERCENT=
TAX_ESV=
TAX_MILITARY_PERCENT=
